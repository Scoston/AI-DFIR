[Unit]
Description=AI-DFIR Fleet Attestation Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ai-dfir
Group=ai-dfir
ExecStart=/opt/ai-dfir/.venv/bin/python /opt/ai-dfir/fleet_agent.py --config /etc/ai-dfir/fleet_agent.json
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ai-dfir /var/log/ai-dfir
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
