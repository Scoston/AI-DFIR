        "*provider*export*.json*",
        "*copilot*.json*",
        "*bedrock*.json*",
        "*vertex*.json*"
      ],
      "priority": "mandatory",
      "rationale": "Independent provider source.",
      "title": "Provider-native exported logs",
      "validation": {
        "min_size_bytes": 1,
        "require_acquisition_hash": true
      }
    },
    {
      "category": "runtime_trust",
      "id": "normalized",
      "presence_patterns": [
        "*provider*normalization*.json*"
      ],
      "priority": "mandatory",
      "rationale": "Normalizes request/model/actor/tool hashes.",
      "title": "AI-DFIR provider normalization",
      "validation": {
        "min_size_bytes": 1,
        "require_acquisition_hash": true
      }
    },
    {
      "category": "runtime_trust",
      "id": "app_trace",
      "presence_patterns": [
        "*agentic_events*.jsonl",
        "*harness*.json*"
