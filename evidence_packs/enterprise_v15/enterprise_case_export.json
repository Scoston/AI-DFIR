      "title": "Export archive SHA-256",
      "validation": {
        "format": "json",
        "min_size_bytes": 1,
        "require_acquisition_hash": true
      }
    },
    {
      "category": "enterprise_v15",
      "id": "manifest",
      "presence_patterns": [
        "*CASE_EXPORT_MANIFEST*.json*"
      ],
