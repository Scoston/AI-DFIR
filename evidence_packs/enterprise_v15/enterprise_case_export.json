      "title": "Signed case export manifest",
      "validation": {
        "format": "json",
        "min_size_bytes": 1,
        "require_acquisition_hash": true
      }
    },
    {
      "category": "enterprise_v15",
      "id": "redaction",
      "presence_patterns": [
        "*redaction*manifest*.json*"
      ],
      "priority": "conditional",
