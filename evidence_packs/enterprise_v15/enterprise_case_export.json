      "title": "Redaction manifest when used",
      "validation": {
        "format": "json",
        "min_size_bytes": 1,
        "require_acquisition_hash": true
      }
    },
    {
      "category": "enterprise_v15",
      "id": "approval",
      "presence_patterns": [
        "*analyst*audit*.jsonl",
