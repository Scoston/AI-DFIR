{
  "artifacts": [
    {
      "category": "enterprise_v15",
      "id": "token_verification",
      "presence_patterns": [
        "*oidc*principal*.json*"
      ],
      "priority": "mandatory",
      "rationale": "Establishes authenticated subject/tenant/roles.",
      "title": "Pinned-JWKS token verification",
      "validation": {
        "format": "json",
        "min_size_bytes": 1,
        "require_acquisition_hash": true
      }
    },
    {
      "category": "enterprise_v15",
      "id": "jwks",
      "presence_patterns": [
        "*jwks*.json*"
      ],
      "priority": "mandatory",
      "rationale": "Defines identity trust root.",
      "title": "Pinned issuer JWKS acquisition",
      "validation": {
        "format": "json",
        "min_size_bytes": 1,
        "require_acquisition_hash": true
      }
    },
    {
      "category": "enterprise_v15",
