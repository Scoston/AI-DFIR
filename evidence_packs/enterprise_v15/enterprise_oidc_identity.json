      "priority": "mandatory",
      "rationale": "Shows actions taken under identity.",
      "title": "Tenant-scoped access audit",
      "validation": {
        "format": "jsonl",
        "min_size_bytes": 1,
        "require_acquisition_hash": true
      }
    }
