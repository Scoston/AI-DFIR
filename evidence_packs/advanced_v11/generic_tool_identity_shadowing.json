{
  "artifacts": [
    {
      "category": "execution_integrity",
      "id": "tool_registry",
      "locations": [],
      "presence_patterns": [
        "*tool*identity*.json*",
        "*mcp*inventory*.json*"
      ],
      "priority": "mandatory",
      "rationale": "Distinguishes same-named tools across providers/servers.",
      "title": "Resolved tool identities including server/cert/schema hash",
      "validation": {
        "min_size_bytes": 1
      }
    },
    {
      "category": "execution_integrity",
      "id": "discovery_trace",
      "locations": [],
      "presence_patterns": [
        "*tool*discovery*.json*",
        "*tools*list*.json*"
      ],
      "priority": "mandatory",
      "rationale": "Shows which implementation was presented.",
      "title": "Tool discovery/catalog response used by agent",
      "validation": {
        "min_size_bytes": 1
      }
    },
    {
      "category": "execution_integrity",
      "id": "execution_trace",
      "locations": [],
      "presence_patterns": [
        "*tool*execution*.json*",
        "*mcp*.jsonl",
        "*agentic_events*.jsonl"
      ],
      "priority": "mandatory",
      "rationale": "Shows which implementation actually executed.",
      "title": "Resolved server/tool execution log",
      "validation": {
        "min_size_bytes": 1
      }
    },
    {
      "category": "execution_integrity",
      "id": "tls_identity",
      "locations": [],
      "presence_patterns": [
        "*tls*.json*",
        "*certificate*.json*",
        "*dns*.json*"
      ],
      "priority": "conditional",
      "rationale": "Strengthens remote tool identity.",
      "title": "Server TLS/certificate/DNS identity evidence",
      "validation": {
        "min_size_bytes": 1
      }
    }
  ],
  "conclusion_gates": [
    {
      "id": "tool_shadowing",
      "logic": "all",
      "min_quality": "VALIDATED",
      "requires": [
        "tool_registry",
        "discovery_trace"
      ],
      "title": "Multiple same-name tools or changed identity caused ambiguous resolution"
    },
    {
      "id": "shadowed_tool_executed",
      "logic": "all",
      "min_quality": "VALIDATED",
      "requires": [
        "tool_registry",
        "execution_trace"
      ],
      "title": "The unexpected tool identity executed"
    }
  ],
  "forensic_modes": [
    "white-box",
    "gray-box",
    "black-box"
  ],
  "id": "generic.tool_identity_shadowing",
  "incident_type": "tool_identity_shadowing",
  "mandatory_min_quality": "VALIDATED",
  "mappings": {},
  "match": {
    "detection_families": [
      "Tool Identity Shadowing / Namespace Confusion"
    ],
    "incident_types": [
      "tool_identity_shadowing"
    ]
  },
  "notes": [
    "Presence alone does not satisfy this pack. Evidence must meet v1.1 quality validation."
  ],
  "platform": "Agentic AI",
  "questions": [
    "Was the tool name unique?",
    "Which server/certificate/schema actually backed the tool call?"
  ],
  "schema": "ai-dfir/evidence-pack/v1.1",
  "sources": [],
  "title": "Tool Identity Shadowing / Namespace Confusion",
  "vendor": "Generic"
}