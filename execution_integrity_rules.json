      "severity": "critical",
      "signals": [
        "mcp_tool_schema_changed",
        "unexpected_mcp_tool",
        "unexpected_mcp_server"
      ]
    },
    {
      "pack": "generic.workspace_instruction_poisoning",
      "severity": "critical",
      "signals": [
        "workspace_control_file_added",
        "workspace_control_file_changed",
        "workspace_control_symlink"
      ]
    },
    {
